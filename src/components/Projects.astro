---
import Section from "./Section.astro";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
  lang: "fr" | "en";
}

const { projects, lang } = Astro.props;
---

<Section text={lang === "fr" ? "Projets" : "Projects"} href="projects">
  <div class="grid gap-6 sm:grid-cols-2">
    {
      projects.map(({ name, summary, linkPreview, linkSource, tags }) => (
        <article
          class="glass flex h-full flex-col rounded-2xl p-6 transition-colors duration-200 hover:border-accent/40"
        >
          <h3 class="mb-3 font-display text-2xl font-medium text-fg">
            {name}
          </h3>
          <p class="mb-5 text-base text-muted">{summary}</p>
          {tags ? (
            <ul class="mb-5 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="rounded-full border border-accent/30 px-3 py-1 text-xs text-accent-soft">
                  {tag}
                </li>
              ))}
            </ul>
          ) : null}
          <div class="mt-auto flex items-center justify-start gap-5 pt-4 text-sm font-medium">
            {linkSource ? (
              <a
                href={linkSource}
                target="_blank"
                rel="noopener"
                class="text-fg hover:text-accent"
                aria-label={`${lang === "fr" ? "Voir le code source de" : "View source code for"} ${name}`}
              >
                Source ↗
              </a>
            ) : null}
            {linkPreview ? (
              <a
                href={linkPreview}
                target="_blank"
                rel="noopener"
                class="text-fg hover:text-accent"
                aria-label={`${lang === "fr" ? "Ouvrir le projet" : "Open project"} ${name}`}
              >
                {lang === "fr" ? "Ouvrir ↗" : "Visit ↗"}
              </a>
            ) : null}
          </div>
        </article>
      ))
    }
  </div>
</Section>
