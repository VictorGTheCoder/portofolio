---
import type { HeroProps } from "@types";
import NeuralBackground from "./NeuralBackground.astro";
type Props = HeroProps;

const { name, specialty, summary } = Astro.props;
const english = Astro.url.pathname.startsWith("/en");
---

<section
  id="hero"
  class="group relative isolate -mt-20 w-screen mx-[calc(50%-50vw)] flex min-h-[88vh] flex-col justify-center overflow-hidden py-28 md:py-40"
  data-spotlight
>
  <NeuralBackground />

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-500 group-hover:opacity-100 motion-reduce:transition-none"
    style="background: radial-gradient(400px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--color-accent) 25%, transparent), transparent 70%);"
  >
  </div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-t from-bg to-transparent md:h-64"
  >
  </div>

  <div class="mx-auto w-full max-w-5xl px-5">
    <h1
      class="mb-3 font-display text-6xl font-bold tracking-tightest text-fg sm:text-7xl md:text-8xl"
    >
      {name}
    </h1>
    <p class="mb-8 font-display text-3xl font-bold tracking-tighter text-accent sm:text-4xl md:text-5xl">
      {specialty}
    </p>
    <p class="mb-12 max-w-2xl text-base text-muted md:text-lg">
      {summary}
    </p>

    <div class="flex flex-wrap gap-4">
      <a
        href="#projects"
        class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white transition-transform duration-200 motion-safe:hover:scale-105 hover:bg-accent-soft motion-safe:active:scale-[.98]"
      >
        {english ? "View my projects" : "Voir mes projets"}
      </a>
      <a
        href="#contact"
        class="rounded-full border border-border px-6 py-3 text-sm font-semibold text-fg transition-colors duration-200 hover:border-accent hover:text-accent"
      >
        {english ? "Get in touch" : "Me contacter"}
      </a>
    </div>
  </div>
</section>

<script>
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  if (!prefersReduced) {
    const hero = document.querySelector<HTMLElement>("[data-spotlight]");
    hero?.addEventListener("mousemove", (e) => {
      const r = hero.getBoundingClientRect();
      hero.style.setProperty("--mx", `${e.clientX - r.left}px`);
      hero.style.setProperty("--my", `${e.clientY - r.top}px`);
    });

  }
</script>
